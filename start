<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>NSI // Interface v98</title>
<style>
  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: #008080; /* Win98 teal */
    font-family: "MS Sans Serif", system-ui, sans-serif;
    overflow: hidden;
    color: #000;
    transition: opacity 1s ease-out;
  }

  /* CRT overlay */
  #crt-overlay {
    pointer-events: none;
    position: fixed;
    inset: 0;
    background:
      repeating-linear-gradient(
        to bottom,
        rgba(255,255,255,0.03),
        rgba(255,255,255,0.03) 1px,
        rgba(0,0,0,0.1) 1px,
        rgba(0,0,0,0.1) 3px
      );
    mix-blend-mode: soft-light;
    opacity: 0.5;
    z-index: 999;
  }

  /* Boot screen */
  #boot-screen {
    position: fixed;
    inset: 0;
    background: #000;
    color: #0f0;
    font-family: "Courier New", monospace;
    padding: 20px;
    font-size: 14px;
    white-space: pre-wrap;
    overflow: hidden;
    z-index: 100;
  }

  /* Desktop */
  #desktop {
    position: fixed;
    inset: 0;
    display: none;
  }

  /* Taskbar */
  #taskbar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 32px;
    background: #c0c0c0;
    border-top: 2px solid #ffffff;
    display: flex;
    align-items: center;
    padding: 0 6px;
    z-index: 50;
  }

  #start-btn {
    background: #c0c0c0;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #404040;
    border-bottom: 2px solid #404040;
    padding: 4px 12px;
    font-weight: bold;
    cursor: pointer;
    margin-right: 10px;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  #start-btn span {
    font-size: 14px;
  }

  #taskbar-title {
    color: #000;
    font-size: 14px;
  }

  #taskbar-status {
    margin-left: auto;
    font-size: 11px;
    color: #333;
  }

  /* Start menu */
  #start-menu {
    position: fixed;
    bottom: 32px;
    left: 0;
    width: 220px;
    background: #c0c0c0;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #404040;
    border-bottom: 2px solid #404040;
    display: none;
    z-index: 60;
  }

  #start-menu-header {
    background: #000080;
    color: #fff;
    padding: 6px;
    font-weight: bold;
    font-size: 14px;
  }

  .start-item {
    padding: 6px 8px;
    font-size: 13px;
    cursor: pointer;
  }

  .start-item:hover {
    background: #000080;
    color: #fff;
  }

  /* Desktop icons */
  .icon {
    position: absolute;
    top: 40px;
    left: 30px;
    text-align: center;
    color: #fff;
    cursor: pointer;
    width: 80px;
    font-size: 12px;
  }

  .icon img {
    width: 32px;
    height: 32px;
    image-rendering: pixelated;
    display: block;
    margin: 0 auto 4px;
  }

  /* Window style */
  .window {
    width: 520px;
    height: 360px;
    background: #c0c0c0;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #404040;
    border-bottom: 2px solid #404040;
    position: absolute;
    top: 80px;
    left: 80px;
    display: none;
    flex-direction: column;
    z-index: 10;
  }

  .titlebar {
    background: linear-gradient(to right, #000080, #1084d0);
    color: white;
    padding: 2px 4px;
    cursor: move;
    font-size: 13px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .titlebar span {
    margin-left: 4px;
  }

  .title-buttons {
    display: flex;
    gap: 2px;
  }

  .title-btn {
    width: 16px;
    height: 14px;
    background: #c0c0c0;
    border-top: 1px solid #ffffff;
    border-left: 1px solid #ffffff;
    border-right: 1px solid #404040;
    border-bottom: 1px solid #404040;
    text-align: center;
    line-height: 12px;
    font-size: 10px;
    cursor: pointer;
    color: #000;
  }

  .content {
    padding: 8px;
    background: #e0e0e0;
    flex: 1;
    overflow: auto;
    font-size: 13px;
  }

  h3 {
    margin-top: 0;
    font-size: 14px;
  }

  /* File explorer */
  .explorer-layout {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 8px;
    height: 100%;
  }

  .explorer-sidebar {
    background: #c0c0c0;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #404040;
    border-bottom: 2px solid #404040;
    padding: 4px;
    font-size: 12px;
  }

  .explorer-main {
    background: #ffffff;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #404040;
    border-bottom: 2px solid #404040;
    padding: 6px;
    font-size: 12px;
  }

  .folder {
    padding: 2px 4px;
    cursor: pointer;
  }

  .folder:hover {
    background: #000080;
    color: #fff;
  }

  .file {
    padding: 2px 4px;
    cursor: pointer;
  }

  .file:hover {
    background: #c0d0ff;
  }

  .file-view {
    white-space: pre-wrap;
    font-family: "Courier New", monospace;
  }

  /* Glitch */
  .glitch {
    animation: glitch 0.3s steps(2) 3;
  }

  @keyframes glitch {
    0% { transform: translate(0,0); filter: hue-rotate(0deg); }
    25% { transform: translate(-2px,1px); filter: hue-rotate(40deg); }
    50% { transform: translate(2px,-1px); filter: hue-rotate(-40deg); }
    75% { transform: translate(-1px,2px); filter: hue-rotate(20deg); }
    100% { transform: translate(0,0); filter: hue-rotate(0deg); }
  }

  /* Hidden / critical window */
  #node12a {
    border-color: #800000;
  }

  #node12a .titlebar {
    background: linear-gradient(to right, #800000, #c00000);
  }

  #node12a .content {
    background: #1a0000;
    color: #fdd;
  }

  .warning-text {
    color: #800;
    font-weight: bold;
  }

  input, button {
    font-family: inherit;
    font-size: 12px;
  }

  input {
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #404040;
    border-bottom: 2px solid #404040;
    padding: 2px 4px;
    background: #ffffff;
  }

  button {
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #404040;
    border-bottom: 2px solid #404040;
    background: #c0c0c0;
    padding: 2px 8px;
    cursor: pointer;
  }

  button:active {
    border-top: 2px solid #404040;
    border-left: 2px solid #404040;
    border-right: 2px solid #ffffff;
    border-bottom: 2px solid #ffffff;
  }
</style>
</head>
