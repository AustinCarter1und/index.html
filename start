<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>NSI // Interface v98</title>
<style>
  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: #008080; /* Win98 teal */
    font-family: "MS Sans Serif", system-ui, sans-serif;
    overflow: hidden;
    color: #000;
  }

  /* CRT overlay */
  #crt-overlay {
    pointer-events: none;
    position: fixed;
    inset: 0;
    background:
      repeating-linear-gradient(
        to bottom,
        rgba(255,255,255,0.03),
        rgba(255,255,255,0.03) 1px,
        rgba(0,0,0,0.1) 1px,
        rgba(0,0,0,0.1) 3px
      );
    mix-blend-mode: soft-light;
    opacity: 0.5;
    z-index: 999;
  }

  /* Boot screen */
  #boot-screen {
    position: fixed;
    inset: 0;
    background: #000;
    color: #0f0;
    font-family: "Courier New", monospace;
    padding: 20px;
    font-size: 14px;
    white-space: pre-wrap;
    overflow: hidden;
  }

  /* Desktop */
  #desktop {
    position: fixed;
    inset: 0;
    display: none;
  }

  /* Taskbar */
  #taskbar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 32px;
    background: #c0c0c0;
    border-top: 2px solid #ffffff;
    display: flex;
    align-items: center;
    padding: 0 6px;
    z-index: 50;
  }

  #start-btn {
    background: #c0c0c0;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #404040;
    border-bottom: 2px solid #404040;
    padding: 4px 12px;
    font-weight: bold;
    cursor: pointer;
    margin-right: 10px;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  #start-btn span {
    font-size: 14px;
  }

  #taskbar-title {
    color: #000;
    font-size: 14px;
  }

  /* Start menu */
  #start-menu {
    position: fixed;
    bottom: 32px;
    left: 0;
    width: 220px;
    background: #c0c0c0;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #404040;
    border-bottom: 2px solid #404040;
    display: none;
    z-index: 60;
  }

  #start-menu-header {
    background: #000080;
    color: #fff;
    padding: 6px;
    font-weight: bold;
    font-size: 14px;
  }

  .start-item {
    padding: 6px 8px;
    font-size: 13px;
    cursor: pointer;
  }

  .start-item:hover {
    background: #000080;
    color: #fff;
  }

  /* Desktop icons */
  .icon {
    position: absolute;
    top: 40px;
    left: 40px;
    text-align: center;
    color: #fff;
    cursor: pointer;
    width: 80px;
    font-size: 12px;
  }

  .icon img {
    width: 32px;
    height: 32px;
    image-rendering: pixelated;
    display: block;
    margin: 0 auto 4px;
  }

  /* Window style */
  .window {
    width: 520px;
    height: 360px;
    background: #c0c0c0;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #404040;
    border-bottom: 2px solid #404040;
    position: absolute;
    top: 80px;
    left: 80px;
    display: none;
    flex-direction: column;
    z-index: 10;
  }

  .titlebar {
    background: linear-gradient(to right, #000080, #1084d0);
    color: white;
    padding: 2px 4px;
    cursor: move;
    font-size: 13px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .titlebar span {
    margin-left: 4px;
  }

  .title-buttons {
    display: flex;
    gap: 2px;
  }

  .title-btn {
    width: 16px;
    height: 14px;
    background: #c0c0c0;
    border-top: 1px solid #ffffff;
    border-left: 1px solid #ffffff;
    border-right: 1px solid #404040;
    border-bottom: 1px solid #404040;
    text-align: center;
    line-height: 12px;
    font-size: 10px;
    cursor: pointer;
    color: #000;
  }

  .content {
    padding: 8px;
    background: #e0e0e0;
    flex: 1;
    overflow: auto;
    font-size: 13px;
  }

  h3 {
    margin-top: 0;
    font-size: 14px;
  }

  /* File explorer */
  .explorer-layout {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 8px;
    height: 100%;
  }

  .explorer-sidebar {
    background: #c0c0c0;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #404040;
    border-bottom: 2px solid #404040;
    padding: 4px;
    font-size: 12px;
  }

  .explorer-main {
    background: #ffffff;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #404040;
    border-bottom: 2px solid #404040;
    padding: 6px;
    font-size: 12px;
  }

  .folder {
    padding: 2px 4px;
    cursor: pointer;
  }

  .folder:hover {
    background: #000080;
    color: #fff;
  }

  .file {
    padding: 2px 4px;
    cursor: pointer;
  }

  .file:hover {
    background: #c0d0ff;
  }

  .file-view {
    white-space: pre-wrap;
    font-family: "Courier New", monospace;
  }

  /* Glitch */
  .glitch {
    animation: glitch 0.3s steps(2) 3;
  }

  @keyframes glitch {
    0% { transform: translate(0,0); filter: hue-rotate(0deg); }
    25% { transform: translate(-2px,1px); filter: hue-rotate(40deg); }
    50% { transform: translate(2px,-1px); filter: hue-rotate(-40deg); }
    75% { transform: translate(-1px,2px); filter: hue-rotate(20deg); }
    100% { transform: translate(0,0); filter: hue-rotate(0deg); }
  }

  /* Hidden / critical window */
  #node12a {
    border-color: #800000;
  }

  #node12a .titlebar {
    background: linear-gradient(to right, #800000, #c00000);
  }

  #node12a .content {
    background: #1a0000;
    color: #fdd;
  }

  .warning-text {
    color: #800;
    font-weight: bold;
  }

  input, button {
    font-family: inherit;
    font-size: 12px;
  }

  input {
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #404040;
    border-bottom: 2px solid #404040;
    padding: 2px 4px;
    background: #ffffff;
  }

  button {
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #404040;
    border-bottom: 2px solid #404040;
    background: #c0c0c0;
    padding: 2px 8px;
    cursor: pointer;
  }

  button:active {
    border-top: 2px solid #404040;
    border-left: 2px solid #404040;
    border-right: 2px solid #ffffff;
    border-bottom: 2px solid #ffffff;
  }
</style>
</head>
<body>

<div id="crt-overlay"></div>

<!-- BOOT SCREEN -->
<div id="boot-screen"></div>

<!-- DESKTOP -->
<div id="desktop">
  <!-- Desktop icons -->
  <div class="icon" style="top:40px;left:30px;" onclick="openWindow('overview')">
    <img src="https://icons.iconarchive.com/icons/benjigarner/softdimension/32/My-Computer-icon.png" alt="">
    <div>Overview</div>
  </div>

  <div class="icon" style="top:120px;left:30px;" onclick="openWindow('research')">
    <img src="https://icons.iconarchive.com/icons/benjigarner/softdimension/32/Search-icon.png" alt="">
    <div>Research</div>
  </div>

  <div class="icon" style="top:200px;left:30px;" onclick="openWindow('nodes')">
    <img src="https://icons.iconarchive.com/icons/benjigarner/softdimension/32/Network-icon.png" alt="">
    <div>Nodes</div>
  </div>

  <div class="icon" style="top:280px;left:30px;" onclick="openWindow('explorer')">
    <img src="https://icons.iconarchive.com/icons/benjigarner/softdimension/32/Folder-icon.png" alt="">
    <div>Files</div>
  </div>

  <div class="icon" style="top:360px;left:30px;" onclick="openWindow('access')">
    <img src="https://icons.iconarchive.com/icons/benjigarner/softdimension/32/Lock-icon.png" alt="">
    <div>Access</div>
  </div>

  <!-- Windows -->
  <div id="overview" class="window">
    <div class="titlebar">
      <span>NSI — Overview</span>
      <div class="title-buttons">
        <div class="title-btn" onclick="closeWindow('overview')">X</div>
      </div>
    </div>
    <div class="content">
      <h3>Nodal Systems Institute</h3>
      <p>Applied Spatial Analysis Division.</p>
      <p>NSI monitors, maps, and stabilizes anomalous spatial nodes across controlled facilities.</p>
      <p>Public cover: environmental geometry and architectural stress analysis.</p>
    </div>
  </div>

  <div id="research" class="window">
    <div class="titlebar">
      <span>NSI — Research</span>
      <div class="title-buttons">
        <div class="title-btn" onclick="closeWindow('research')">X</div>
      </div>
    </div>
    <div class="content">
      <h3>Active Research Programs</h3>
      <ul>
        <li>Environmental Geometry Modeling</li>
        <li>Node Stability Index Tracking</li>
        <li>Perception Drift Studies</li>
        <li>Field Operations Analysis</li>
      </ul>
      <p>Note: Node 04B is designated as a training node for new Level 3 personnel.</p>
    </div>
  </div>

  <div id="nodes" class="window">
    <div class="titlebar">
      <span>NSI — Node Database</span>
      <div class="title-buttons">
        <div class="title-btn" onclick="closeWindow('nodes')">X</div>
      </div>
    </div>
    <div class="content">
      <h3>Registered Nodes</h3>
      <p><b>NODE 04B</b> — Transitional corridor exhibiting mild spatial drift and predictive acoustic echo.</p>
      <p><b>NODE 07F</b> — Stable node, low activity, used for baseline measurements.</p>
      <p><b>NODE 12A</b> — <span class="warning-text">CRITICAL</span>. Access restricted to Level 5 personnel. Direct interaction prohibited.</p>
      <p style="font-size:11px;color:#555;">Note: Repeated queries about NODE 12A are logged.</p>
    </div>
  </div>

  <div id="explorer" class="window">
    <div class="titlebar">
      <span>NSI — File Explorer</span>
      <div class="title-buttons">
        <div class="title-btn" onclick="closeWindow('explorer')">X</div>
      </div>
    </div>
    <div class="content">
      <div class="explorer-layout">
        <div class="explorer-sidebar">
          <div><b>Folders</b></div>
          <div class="folder" onclick="showFolder('logs')">Logs</div>
          <div class="folder" onclick="showFolder('nodes')">Nodes</div>
          <div class="folder" onclick="showFolder('internal')">Internal</div>
        </div>
        <div class="explorer-main">
          <div id="file-list"></div>
          <hr>
          <div id="file-view" class="file-view"></div>
        </div>
      </div>
    </div>
  </div>

  <div id="access" class="window">
    <div class="titlebar">
      <span>NSI — Access Portal</span>
      <div class="title-buttons">
        <div class="title-btn" onclick="closeWindow('access')">X</div>
      </div>
    </div>
    <div class="content">
      <h3>Secure Login</h3>
      <p>Credentials required. Unauthorized access is monitored.</p>
      <label>USER ID</label><br>
      <input id="user-id" type="text" placeholder="enter id..."><br><br>
      <label>PASSWORD</label><br>
      <input id="user-pass" type="password" placeholder="••••••••"><br><br>
      <button onclick="attemptLogin()">Login</button>
      <p id="login-status" style="margin-top:8px;font-size:12px;"></p>
      <p style="font-size:10px;color:#555;">Hint: Level 3 credentials may still be revoked.</p>
    </div>
  </div>

  <!-- Hidden critical node window -->
  <div id="node12a" class="window">
    <div class="titlebar">
      <span>NSI — NODE 12A // CRITICAL</span>
      <div class="title-buttons">
        <div class="title-btn" onclick="closeWindow('node12a')">X</div>
      </div>
    </div>
    <div class="content">
      <h3>NODE 12A — CRITICAL STATUS</h3>
      <p class="warning-text">UNAUTHORIZED ACCESS DETECTED.</p>
      <p>Spatial stability index: 0.41 (THRESHOLD: 0.80)</p>
      <p>Observed behaviors:</p>
      <ul>
        <li>Non‑Euclidean corridor recursion.</li>
        <li>Temporal desynchronization events.</li>
        <li>Perception drift beyond safe limits.</li>
      </ul>
      <p>Further interaction with this node may destabilize the interface.</p>
    </div>
  </div>

  <!-- Taskbar -->
  <div id="taskbar">
    <div id="start-btn" onclick="toggleStartMenu()">
      <span>⊞</span><span>Start</span>
    </div>
    <div id="taskbar-title">NSI Interface v98</div>
  </div>

  <!-- Start menu -->
  <div id="start-menu">
    <div id="start-menu-header">NODAL SYSTEMS</div>
    <div class="start-item" onclick="openWindow('overview');toggleStartMenu(false)">Overview</div>
    <div class="start-item" onclick="openWindow('research');toggleStartMenu(false)">Research</div>
    <div class="start-item" onclick="openWindow('nodes');toggleStartMenu(false)">Nodes</div>
    <div class="start-item" onclick="openWindow('explorer');toggleStartMenu(false)">File Explorer</div>
    <div class="start-item" onclick="openWindow('access');toggleStartMenu(false)">Access Portal</div>
  </div>
</div>

<script>
  /* BOOT SEQUENCE */
  const bootLines = [
    "NSI // NODAL SYSTEMS INSTITUTE",
    "INTERFACE v98.4 — INITIALIZING...",
    "",
    "CHECKING SYSTEM MEMORY............. [ OK ]",
    "LOADING NODE MAPPING MODULES....... [ OK ]",
    "MOUNTING ARCHIVE VOLUMES........... [ OK ]",
    "SCANNING ACTIVE NODES..............",
    "  NODE_04B  [ TRANSITIONAL ]",
    "  NODE_07F  [ STABLE ]",
    "  NODE_12A  [ CRITICAL ]",
    "",
    "SPATIAL STABILITY INDEX............ [ WARN ]",
    "  LAST SSI: 0.73 (THRESHOLD: 0.80)",
    "",
    "ROUTING TO NSI INTERFACE v98...",
    ""
  ];

  const bootScreen = document.getElementById("boot-screen");
  let bootIndex = 0;

  function typeBootLine() {
    if (bootIndex >= bootLines.length) {
      setTimeout(() => {
        bootScreen.style.display = "none";
        document.getElementById("desktop").style.display = "block";
      }, 600);
      return;
    }
    const line = document.createElement("div");
    bootScreen.appendChild(line);
    let i = 0;
    const text = bootLines[bootIndex];
    const interval = setInterval(() => {
      line.textContent = text.slice(0, i);
      i++;
      if (i > text.length) {
        clearInterval(interval);
        bootIndex++;
        setTimeout(typeBootLine, 80);
      }
    }, 12);
  }

  typeBootLine();

  /* WINDOW MANAGEMENT */
  let zCounter = 20;

  function openWindow(id) {
    const win = document.getElementById(id);
    if (!win) return;
    win.style.display = "flex";
    win.style.zIndex = ++zCounter;
    maybeGlitch(id);
  }

  function closeWindow(id) {
    const win = document.getElementById(id);
    if (!win) return;
    win.style.display = "none";
  }

  /* DRAGGABLE WINDOWS */
  document.querySelectorAll('.window').forEach(win => {
    const bar = win.querySelector('.titlebar');
    let offsetX, offsetY, dragging = false;

    bar.addEventListener('mousedown', e => {
      dragging = true;
      win.style.zIndex = ++zCounter;
      offsetX = e.clientX - win.offsetLeft;
      offsetY = e.clientY - win.offsetTop;
    });

    document.addEventListener('mousemove', e => {
      if (dragging) {
        win.style.left = (e.clientX - offsetX) + "px";
        win.style.top = (e.clientY - offsetY) + "px";
      }
    });

    document.addEventListener('mouseup', () => dragging = false);
  });

  /* START MENU */
  function toggleStartMenu(force) {
    const menu = document.getElementById("start-menu");
    if (typeof force === "boolean") {
      menu.style.display = force ? "block" : "none";
      return;
    }
    menu.style.display = (menu.style.display === "block") ? "none" : "block";
  }

  document.addEventListener("click", e => {
    const menu = document.getElementById("start-menu");
    const startBtn = document.getElementById("start-btn");
    if (!menu.contains(e.target) && e.target !== startBtn && !startBtn.contains(e.target)) {
      menu.style.display = "none";
    }
  });

  /* FILE EXPLORER DATA */
  const folders = {
    logs: [
      { name: "log_04B_01.txt", content: "NODE 04B // INITIAL ENTRY\n\nMild spatial drift detected. Corridor length variance: 2.3%.\nNo personnel loss.\n" },
      { name: "log_04B_12.txt", content: "NODE 04B // EVENT SHIFT-12\n\nCorridor shortened by 14% during power outage.\nCarpet fibers reversed direction.\n" }
    ],
    nodes: [
      { name: "node_04B.txt", content: "NODE 04B\nCategory: Transitional\nClearance: Level 3\nNotes: Predictive acoustic echo observed.\n" },
      { name: "node_12A.txt", content: "NODE 12A\nCategory: Critical\nClearance: Level 5\nWARNING: DO NOT ENTER.\n" }
    ],
    internal: [
      { name: "staff_roster.txt", content: "NSI STAFF (REDACTED)\n- Beck, I. (L3)\n- Maxwell, K. (L4)\n- Dawkins, A. (L5)\n" },
      { name: "policy_12A.txt", content: "POLICY: NODE 12A\nAll access revoked.\nAll queries logged.\n" }
    ]
  };

  function showFolder(name) {
    const list = document.getElementById("file-list");
    const view = document.getElementById("file-view");
    list.innerHTML = "";
    view.textContent = "";
    const files = folders[name] || [];
    files.forEach(file => {
      const div = document.createElement("div");
      div.className = "file";
      div.textContent = file.name;
      div.onclick = () => {
        view.textContent = file.content;
        if (file.name.includes("12A")) {
          triggerCriticalGlitch();
        }
      };
      list.appendChild(div);
    });
  }

  // default folder
  showFolder("logs");

  /* LOGIN / BACKDOOR */
  function attemptLogin() {
    const user = document.getElementById("user-id").value.trim();
    const pass = document.getElementById("user-pass").value.trim();
    const status = document.getElementById("login-status");

    // Backdoor: beck.i / L3-NODE-04B
    if (user === "beck.i" && pass === "L3-NODE-04B") {
      status.style.color = "#008000";
      status.textContent = "ACCESS GRANTED // OVERRIDE ACTIVE";
      setTimeout(() => {
        openWindow("node12a");
        triggerCriticalGlitch();
      }, 600);
      return;
    }

    // Wrong user
    if (!user) {
      status.style.color = "#800000";
      status.textContent = "NO RECORD FOUND.";
      return;
    }

    // Wrong pass
    if (!pass) {
      status.style.color = "#800000";
      status.textContent = "CREDENTIAL MISMATCH.";
      return;
    }

    // Default deny
    status.style.color = "#800000";
    status.textContent = "ACCESS DENIED // LEVEL INSUFFICIENT.";
    maybeGlitch("access");
  }

  /* GLITCH EVENTS */
  function maybeGlitch(context) {
    // small chance to glitch when opening certain windows
    if (Math.random() < 0.2 || context === "node12a") {
      triggerGlitch();
    }
  }

  function triggerGlitch() {
    const desktop = document.getElementById("desktop");
    desktop.classList.add("glitch");
    setTimeout(() => desktop.classList.remove("glitch"), 400);
  }

  function triggerCriticalGlitch() {
    triggerGlitch();
    setTimeout(triggerGlitch, 300);
  }
</script>
</body>
</html>
